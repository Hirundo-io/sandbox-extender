  "sessionContext": [
    "Prefer established packages with multiple maintainers and recent updates.",
    "No high/critical known vulnerabilities; inspect lockfiles and audit data.",
    "Keep dependency changes narrow; explain package and lockfile changes.",
    "uv sync remains unsupported until the host bridge can clear or bind UV_PROJECT_ENVIRONMENT; it can redirect writes outside the workspace."
  ],
  "groupings": [
    {
      "id": "dependency-management",
      "policies": {
        "allowNpmDependencyChanges": [
          "permit(principal, action, resource)",
          "when {",
          "  context.materialized.manager == \"npm\" &&",
          "  [\"install\", \"i\", \"uninstall\", \"remove\", \"update\", \"up\"].contains(context.materialized.command) &&",
          "  context.materialized.optionCount == 7 && context.materialized.duplicateOptionCount == 0 &&",
          "  context.materialized.unknownOptionCount == 0 && context.materialized.pathsWithinWorkspace &&",
          "  context.materialized.positionalsValid && context.materialized.options.ignoreScripts &&",
          "  context.materialized.options.packageLockOnly && context.materialized.options.global == \"false\" &&",
          "  context.materialized.options.location == \"project\" && context.materialized.options.workspaces == \"false\"",
          "};"
        ],
        "allowBunDependencyChanges": [
          "permit(principal, action, resource)",
          "when {",
          "  context.materialized.manager == \"bun\" &&",
          "  [\"install\", \"i\", \"add\", \"remove\", \"update\"].contains(context.materialized.command) &&",
          "  context.materialized.optionCount == 4 && context.materialized.duplicateOptionCount == 0 &&",
          "  context.materialized.unknownOptionCount == 0 && context.materialized.pathsWithinWorkspace &&",
          "  context.materialized.positionalsValid && context.materialized.options.ignoreScripts &&",
          "  context.materialized.options.lockfileOnly",
          "};"
        ],
        "allowUvDependencyChanges": [
          "permit(principal, action, resource)",
          "when {",
          "  context.materialized.manager == \"uv\" &&",
          "  [\"add\", \"remove\", \"lock\"].contains(context.materialized.command) &&",
          "  context.materialized.duplicateOptionCount == 0 && context.materialized.unknownOptionCount == 0 &&",
          "  context.materialized.pathsWithinWorkspace && context.materialized.positionalsValid &&",
          "  context.materialized.options.noBuild && context.materialized.options.noConfig &&",
          "  context.materialized.options.noPythonDownloads && context.materialized.options.noSources &&",
          "  ((context.materialized.command == \"lock\" && context.materialized.optionCount == 6) ||",
          "   (context.materialized.command != \"lock\" && context.materialized.optionCount == 7 && context.materialized.options.noSync))",
          "};"
        ],
        "allowPixiDependencyChanges": [
          "permit(principal, action, resource)",
          "when {",
          "  context.materialized.manager == \"pixi\" &&",
          "  [\"add\", \"remove\", \"update\", \"lock\"].contains(context.materialized.command) &&",
          "  context.materialized.optionCount == 4 && context.materialized.duplicateOptionCount == 0 &&",
          "  context.materialized.unknownOptionCount == 0 && context.materialized.pathsWithinWorkspace &&",
          "  context.materialized.positionalsValid && context.materialized.options.noConfig &&",
          "  context.materialized.options.noInstall && context.materialized.options.offline",
          "};"
        ]
      }
    }
  ]
}
