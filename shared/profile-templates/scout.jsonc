{
  "id": "scout",
  "policyRevision": "pending-review",
  // Every Scout shell request must contain exactly one executable command.
  "singleCommand": true,
  "allowedTargets": [],
  "activationMaterializer": {
    "file": "materializers/activation/target-set.ts",
    "integrity": "6f5e53d113204d4a6530b66420c5eb81b6883fe8328877d91f971da584a3c00c",
    "language": "typescript",
    "permissions": {
      // Workspace activation resolves and verifies the selected directory.
      "read": ["$WORKING_DIRECTORY"],
      "write": [],
      "env": [],
      "net": [],
      "sys": [],
      "run": [],
      "ffi": [],
    },
    "runtimeVersion": "2.8.1",
  },
  "requestMaterializer": {
    "file": "materializers/requests/repository.ts",
    "integrity": "f2f5c5fd5cdc8270a06952cd9a55f8176a95d7f0f65ed8c8a8e9e82be00c8168",
    "language": "typescript",
    "permissions": {
      // Policy Core substitutes canonical request paths and verifies containment.
      "read": ["$REQUEST_RESOURCE", "$WORKING_DIRECTORY"],
      "write": [],
      "env": [],
      "net": [],
      "sys": [],
      "run": ["git"],
      "ffi": [],
    },
    "runtimeVersion": "2.8.1",
  },
  "sessionContext": ["Use this profile only for inspection. Do not alter files or remote state."],
  // Local inspection is limited to the listed read-only Git operations. The
  // materializer rejects mutations, unsafe options, path escapes, and helpers.
  "groupings": [
    {
      "id": "read-only-inspection",
      "policies": {
        "allowRemoteInspection": [
          "permit(principal, action, resource)",
          "when {",
          "  context.materialized.argumentsSafe && context.materialized.duplicateOptionCount == 0 &&",
          "  context.materialized.remoteSafe &&",
          "  [",
          "    \"github.issue.list\", \"github.issue.view\", \"github.label.list\",",
          "    \"github.pr.checks\", \"github.pr.diff\", \"github.pr.list\", \"github.pr.view\",",
          "    \"github.release.list\", \"github.release.view\", \"github.repo.list\", \"github.repo.view\",",
          "    \"github.run.list\", \"github.run.view\", \"github.workflow.list\", \"github.workflow.view\",",
          "    \"git.fetch\", \"git.ls-remote\"",
          "  ].contains(context.materialized.operation)",
          "};",
        ],
        "allowLocalInspection": [
          "permit(principal, action, resource)",
          "when {",
          "  context.materialized.argumentsSafe && context.materialized.duplicateOptionCount == 0 &&",
          "  context.materialized.localSafe &&",
          "  [",
          "    \"git.branch\", \"git.config\", \"git.diff\", \"git.log\", \"git.rev-parse\",",
          "    \"git.show\", \"git.status\"",
          "  ].contains(context.materialized.operation)",
          "};",
        ],
      },
    },
  ],
}
