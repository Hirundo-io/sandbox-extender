{
  "name": "sandbox-extender",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "audit": "bun audit"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.12.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "knip": "^6.32.2",
    "typescript": "^5.9.3"
  },
  "knip": {
    "entry": [
      "src/hook-cli.ts",
      "src/mcp-server.ts",
      "src/index.ts",
      "test/**/*.test.ts"
    ],
    "ignore": [
      "templates/resolvers/**/*.js"
    ],
    "ignoreExportsUsedInFile": true
  },
  "engines": {
    "bun": "1.3.9"
  },
  "packageManager": "bun@1.3.9"
}
