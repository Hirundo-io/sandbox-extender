{
  "name": "sandbox-extender",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "precommit": "bun run audit && bun run lint && bun run format:check && bun run knip && bun run typecheck && bun run validate:plugin && bun run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:json": "prettier --write '**/*.json'",
    "format:check": "prettier --check .",
    "check:commit": "bun run precommit",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "validate:plugin": "bun src/validate-plugin.ts",
    "authorize:mutation": "bun src/authorize-mutation.ts",
    "audit": "bun audit"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.12.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "deno": "2.8.1",
    "graphql": "16.14.2",
    "unbash": "4.0.10",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@types/bun": "^1.4.0",
    "@types/deno": "2.7.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.2",
    "typescript": "^5.9.3"
  },
  "knip": {
    "entry": [
      "src/hook-cli.ts",
      "src/mcp-launcher.ts",
      "src/mcp-server.ts",
      "src/index.ts",
      "{shared,src,test}/**/*.test.ts"
    ],
    "ignoreDependencies": [
      "@types/deno",
      "deno"
    ],
    "ignoreExportsUsedInFile": true
  },
  "lint-staged": {
    "**/*.{json,md,ts}": "prettier --write",
    "**/*.ts": "eslint --fix"
  },
  "engines": {
    "bun": "1.3.9"
  },
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "deno",
    "husky"
  ]
}
