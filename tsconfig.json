{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "include": ["src", "shared/materializers/**/*.ts", "test/**/*.test.ts"]
}
