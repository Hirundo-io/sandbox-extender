{
  "id": "maker",
  "policyRevision": "pending-review",
  "allowedTargets": [],
  "sessionContext": [
    "Prefer established packages with multiple maintainers and recent updates.",
    "No high/critical known vulnerabilities; inspect lockfiles and audit data.",
    "Keep dependency changes narrow; explain package and lockfile changes."
  ],
  "groupings": [
    {
      "id": "dependency-management",
      "policies": {
        "allowDependencyChanges": [
          "permit(principal, action, resource)",
          "when {",
          "  context.arguments.command like \"bun install*\" ||",
          "  context.arguments.command like \"bun i*\" ||",
          "  context.arguments.command like \"npm install*\" ||",
          "  context.arguments.command like \"npm i*\" ||",
          "  context.arguments.command like \"npm uninstall*\" ||",
          "  context.arguments.command like \"npm remove*\" ||",
          "  context.arguments.command like \"npm update*\" ||",
          "  context.arguments.command like \"npm up*\" ||",
          "  context.arguments.command like \"bun add*\" ||",
          "  context.arguments.command like \"bun remove*\" ||",
          "  context.arguments.command like \"bun update*\" ||",
          "  context.arguments.command like \"uv add*\" ||",
          "  context.arguments.command like \"uv remove*\" ||",
          "  context.arguments.command like \"uv sync*\" ||",
          "  context.arguments.command like \"uv lock*\" ||",
          "  context.arguments.command like \"pixi install*\" ||",
          "  context.arguments.command like \"pixi i*\" ||",
          "  context.arguments.command like \"pixi add*\" ||",
          "  context.arguments.command like \"pixi remove*\" ||",
          "  context.arguments.command like \"pixi update*\" ||",
          "  context.arguments.command like \"pixi lock*\"",
          "};"
        ]
      }
    }
  ]
}
